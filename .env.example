# Local API port (also the API's published host port in Docker).
PORT=3001
# Docker frontend's published host port.
CLIENT_PORT=8080

# Local development database. Docker uses db:5432 internally.
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=remotebridge

# Optional local override for an external database; leave unset for Compose.
# DATABASE_URL=postgres://user:password@host:5432/database
